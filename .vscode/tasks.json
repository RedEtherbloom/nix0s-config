{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Fast rebuild NixOS",
            "type": "shell",
            "command": "sudo nixos-rebuild switch -v -L --show-trace --flake . --fast",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Rebuild NixOS",
            "type": "shell",
            "command": "sudo nixos-rebuild switch -v -L --show-trace --flake .",
        },
        {
            "label": "Update Nix flake",
            "type": "shell",
            "command": "nix flake update -v"
        },
        {
            "label": "Test-Rebuild NixOS",
            "type": "shell",
            "command": "sudo nixos-rebuild test -v -L --show-trace --flake ."
        },
        {
            "label": "Launch NixOs REPL",
            "type": "shell",
            "command": "sudo nixos-rebuild repl --flake ."
        },
        {
            "label": "Collect & optimise",
            "type": "shell",
            "command": "sudo nix-collect-garbage -d && nix-collect-garbage -d && sudo nix-store --optimise"
        }
    ]
}