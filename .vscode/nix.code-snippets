{
    "cfg_module": {
        "scope": "nix",
        "prefix": "cfg_module",
        "body": [
            "{ config, lib, ... }:",
            "with lib;",
            "let",
            "  cfg = config.${1:myOptions}.${TM_FILENAME_BASE};",
            "in",
            "{",
            "  options.${1:myOptions}.${TM_FILENAME_BASE} = {",
            "\tenable = mkOption {",
            "\t  description = \"Enable ${TM_FILENAME_BASE}\";",
            "\t  type = with types; bool;",
            "\t  default = false;",
            "\t};",
            "  };",
            "",
            "  config = mkIf cfg.enable {",
            "\t$0",
            "  };",
            "}",
        ],
        "description": "Standard nix module with cfg and options"
    },
    "cfgOption": {
        "scope": "nix",
        "prefix": "cfgOption",
        "body": [
            "$1 = mkOption {",
            "\t  description = \"Enable ${2:$1}\";",
            "\t  type = types.bool;",
            "\t  default = false;",
            "};"
        ],
        "description": "Insert a standard nix cfg option"
    },
    "firefoxSearchEngine": {
        "scope": "nix",
        "prefix": "firefoxSearchEngine",
        "body": [
            "\"$1\" = {",
            "\tdefinedAliases = [\"$2\"];",
            "\ticon = \"$3\";",
            "\turls = [",
            "\t\t{",
            "\t\t\ttemplate = \"$4\";",
            "\t\t\tparams = [",
            "\t\t\t{",
            "\t\t\t\tname = \"${5:query}\";",
            "\t\t\t\tvalue = \"{searchTerms}\";",
            "\t\t\t}",
            // Hacky, hopefully there are better ways for:
            // Insert other template and
            // configurable amount of other templates
            "\t\t\t${0:firefoxSearchPara}",
            "\t\t];",
            "\t\t}",
            "\t];",
            "};"
        ],
        "description": "A search engine set in programs.firefox.profiles.<name>.search.engines"
    },
    "firefoxSearchParam": {
        "scope": "nix",
        "prefix": "firefoxSearchParam",
        "body": [
            "{",
            "\tname = \"$1\";",
            "\tvalue = \"$2\";",
            "}",
        ],
        "description": "A search param for a search engine set in programs.firefox.profiles.<name>.search.engines.<otherName>.urls.[]"
    },
}