.include shared_variables.cnf

[ default ]
x509_extensions = v3_req

[ v3_req ]
subjectAltName = @alt_names
keyUsage=critical, digitalSignature, keyEncipherment
basicConstraints=critical,CA:FALSE
extendedKeyUsage=critical,serverAuth
subjectKeyIdentifier = hash

[alt_names]
IP.1 = 127.0.0.1
IP.2 = ::1
IP.4 = 192.168.178.56
IP.3 = 10.69.0.3
DNS.1 = neurodrive
DNS.2 = neurodrive.local
DNS.3 = neurodrive.fritz.box
DNS.4 = neurodrive.fritz.box.
DNS.5 = localhost