Subject: [PATCH] fix: add missing KeepOld restart path

---
 src/lib.rs | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/lib.rs b/src/lib.rs
index f0879ef..6ad8855 100644
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -311,6 +311,10 @@ fn build_switch_plan(
                 {
                     upb.push_decision(UnitDecision::ActiveRefuseManualStop)
                         .action(UnitAction::KeepOld);
+                } else if new_unit_file.switch_method() == unit_file::UnitSwitchMethod::KeepOld {
+                    upb.push_decision(UnitDecision::SwitchMethod(new_unit_file.switch_method()))
+                        .action(UnitAction::KeepOld);
+                // TODO: Report. This seems odd?
                 } else if new_unit_file.switch_method() == unit_file::UnitSwitchMethod::StopOnly {
                     upb.push_decision(UnitDecision::SwitchMethod(new_unit_file.switch_method()))
                         .action(UnitAction::KeepOld);
